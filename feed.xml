---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>en</language>
    {% for issue in site.data.threevoices.issues limit: 12 %}
    <item>
      <title>{{ issue.title | xml_escape }} — {{ issue.month | xml_escape }}</title>
      <link>{{ site.url }}{{ site.baseurl }}/issues/{{ issue.slug }}/cases.html</link>
      <guid isPermaLink="true">{{ site.url }}{{ site.baseurl }}/issues/{{ issue.slug }}/cases.html</guid>
      <description>{{ issue.summary | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
